{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Company",
  "description": "Descriptive fields only. Every number (revenue, funding, employees, share) lives in the claims ledger and is linked here by claim id, so it always carries a source, period and confidence. Unknown fields are omitted, never guessed.",
  "type": "object",
  "required": ["id", "name", "roles", "hq_country", "source_ids", "last_verified"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^CO-[0-9]{4,}$"},
    "name": {"type": "string"},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "roles": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "entity_type ids from ontology.yaml, e.g. foundry, idm, fabless, osat, eda_vendor"},
    "segment_ids": {"type": "array", "items": {"type": "string", "pattern": "^ENT-[0-9]{4,}$"}},
    "hq_country": {"type": "string"},
    "founded": {"type": "integer"},
    "ownership": {"enum": ["public", "private", "state_owned", "subsidiary", "cooperative", "unknown"]},
    "parent_company_id": {"type": "string", "pattern": "^CO-[0-9]{4,}$"},
    "listing": {"type": "string", "description": "exchange:ticker"},
    "stage": {"enum": ["incumbent", "mid_market", "startup", "infrastructure", "service_provider", "unknown"]},
    "business_model": {"type": "string"},
    "products": {"type": "array", "items": {"type": "string"}},
    "customers": {"type": "array", "items": {"type": "string"}},
    "technology": {"type": "string"},
    "regulatory_exposure": {"type": "array", "items": {"type": "string", "pattern": "^REG-[0-9]{4,}$"}},
    "investors": {"type": "array", "items": {"type": "string"}},
    "metric_claim_ids": {"type": "array", "items": {"type": "string", "pattern": "^CLM-[0-9]{4,}$"}, "description": "revenue, funding, employees, capacity, share: all as claims"},
    "strengths_claim_ids": {"type": "array", "items": {"type": "string", "pattern": "^CLM-[0-9]{4,}$"}},
    "limitations_claim_ids": {"type": "array", "items": {"type": "string", "pattern": "^CLM-[0-9]{4,}$"}},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^SRC-[0-9]{4,}$"}},
    "last_verified": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "research_units": {"type": "array", "items": {"type": "string", "pattern": "^RU-[0-9]{4,}$"}}
  }
}
