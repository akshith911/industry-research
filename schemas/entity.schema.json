{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Entity",
  "description": "A node in the knowledge graph that is not a company or a regulation: a participant category, product, process, technology, market segment, standard, role, dataset, place, etc. entity_type must exist in the industry's ontology.yaml.",
  "type": "object",
  "required": ["id", "name", "entity_type", "description"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^ENT-[0-9]{4,}$"},
    "name": {"type": "string"},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "entity_type": {"type": "string"},
    "parent_id": {"type": "string", "pattern": "^ENT-[0-9]{4,}$"},
    "description": {"type": "string"},
    "source_ids": {"type": "array", "items": {"type": "string", "pattern": "^SRC-[0-9]{4,}$"}},
    "research_units": {"type": "array", "items": {"type": "string", "pattern": "^RU-[0-9]{4,}$"}}
  }
}
