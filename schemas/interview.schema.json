{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InterviewQueueItem",
  "description": "An unknown that desk research cannot resolve. Answers from interviews are recorded as claims with claim_type reported_claim and a note 'interview', never as verified public facts.",
  "type": "object",
  "required": ["id", "unknown", "why_it_matters", "who_can_answer", "question", "resolving_evidence", "status"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^INT-[0-9]{4,}$"},
    "unknown": {"type": "string"},
    "why_it_matters": {"type": "string"},
    "who_can_answer": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "roles, e.g. 'fab procurement manager', 'OSAT sales head'"},
    "question": {"type": "string"},
    "resolving_evidence": {"type": "string"},
    "related_claim_ids": {"type": "array", "items": {"type": "string", "pattern": "^CLM-[0-9]{4,}$"}},
    "research_units": {"type": "array", "items": {"type": "string", "pattern": "^RU-[0-9]{4,}$"}},
    "status": {"enum": ["open", "answered", "dropped"]}
  }
}
