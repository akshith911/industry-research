{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opportunity",
  "description": "Only created after the industry map passes the quality audit. Score is computed by irs/score.py from inputs and the weights in config.yaml, never written by hand.",
  "type": "object",
  "required": ["id", "title", "description", "problem_claim_ids", "inputs"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^OPP-[0-9]{4,}$"},
    "title": {"type": "string"},
    "description": {"type": "string"},
    "problem_claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^CLM-[0-9]{4,}$"}},
    "inputs": {
      "type": "object",
      "description": "criterion id (from config.yaml scoring.criteria) -> rating",
      "additionalProperties": {
        "type": "object",
        "required": ["value", "rationale"],
        "additionalProperties": false,
        "properties": {
          "value": {"type": "integer", "minimum": 0, "maximum": 5},
          "evidence_claim_ids": {"type": "array", "items": {"type": "string", "pattern": "^CLM-[0-9]{4,}$"}},
          "rationale": {"type": "string"}
        }
      }
    },
    "red_team_ids": {"type": "array", "items": {"type": "string", "pattern": "^RT-[0-9]{4,}$"}}
  }
}
